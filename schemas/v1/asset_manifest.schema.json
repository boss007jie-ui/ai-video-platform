{
  "$id": "avp.contract.asset-manifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "assets": {
      "type": "array"
    },
    "created_at": {
      "type": "string"
    },
    "manifest_id": {
      "type": "string"
    },
    "manifest_revision": {
      "type": "integer"
    },
    "owner_id": {
      "type": "string"
    },
    "owner_type": {
      "enum": [
        "task",
        "product"
      ],
      "type": "string"
    }
  },
  "required": [
    "manifest_id",
    "manifest_revision",
    "owner_type",
    "owner_id",
    "assets",
    "created_at"
  ],
  "title": "AssetManifest",
  "type": "object",
  "x-avp-authorized-consumers": [
    "all-skills",
    "hermes",
    "codex-maintenance"
  ],
  "x-avp-authorized-producers": [
    "product-knowledge",
    "producing-skill",
    "hermes"
  ],
  "x-avp-registry": "IR-2 Foundation Registry V1",
  "x-avp-version": "1.0.0"
}
