{
  "$id": "avp.contract.approval-record",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "approval_id": {
      "type": "string"
    },
    "approval_type": {
      "type": "string"
    },
    "authority": {
      "type": "object"
    },
    "conditions": {},
    "decided_at": {
      "type": "string"
    },
    "decision_ref": {
      "type": "string"
    },
    "outcome": {
      "enum": [
        "approved",
        "denied",
        "revoked",
        "expired"
      ],
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    },
    "signature": {},
    "subject_ref": {
      "type": "object"
    },
    "supersedes_approval_id": {
      "type": "string"
    },
    "valid_until": {
      "type": "string"
    }
  },
  "required": [
    "approval_id",
    "subject_ref",
    "approval_type",
    "outcome",
    "authority",
    "decided_at",
    "decision_ref"
  ],
  "title": "ApprovalRecord",
  "type": "object",
  "x-avp-authorized-consumers": [
    "hermes",
    "product-knowledge",
    "qa-review",
    "generation-skills",
    "release-tooling",
    "codex-audit"
  ],
  "x-avp-authorized-producers": [
    "authorized-approval-boundary"
  ],
  "x-avp-registry": "IR-2 Foundation Registry V1",
  "x-avp-version": "1.0.0"
}
